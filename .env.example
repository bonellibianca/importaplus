# Configuración Pública y Dominio Autorizado (CORS / Anti-CSRF)
NEXT_PUBLIC_APP_ORIGIN=https://importaplus.com.ar

# Supabase Cloud (Opcional en local: usa persistencia híbrida Excel/CSV si se omite)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cloudflare Turnstile Anti-Bot (Obligatorio en producción si se define)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secreto para autenticar Vercel Cron Jobs en /api/v1/health
CRON_SECRET=
