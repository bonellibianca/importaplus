# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO PARA VERCEL Y PERSISTENCIA EN EXCEL
# Copia este archivo como .env.local para desarrollo local
# ==============================================================================

# 1. Rutas de Libros de Persistencia Excel (.xlsx / .csv)
# El motor DAL lee y persiste los datos directamente sobre estos archivos Excel sin usar SQL:
EXCEL_DB_PATH=DAL/database/ImportaPlus_ExcelDB.xlsx
EXCEL_NCM_PATH=DAL/database/Nomenclatura_NCM_aranceles.xlsx

# 2. Cloudflare Turnstile (Protección Anti-Bot Invisible)
# Obtenible en: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-site-key-turnstile
TURNSTILE_SECRET_KEY=tu-secret-key-turnstile

# 3. Entorno de Ejecución
NODE_ENV=production
